COGNITIVE_THRESHOLD = 0.30      # 30 % di off‑loading
ECHO_THRESHOLD      = 0.40      # 40 % di omogeneità feed
PRIVACY_THRESHOLD   = 0.25      # 25 % di esposizione dati
SYMBIOTIC_FLAG      = True      # attiva la Lex Amoris

# ----------------------------------------------------------------------
# Logger
